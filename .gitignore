# =============================================================================
# SHIELD — .gitignore
# =============================================================================

# ---- Python (root Streamlit app + backend) ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
backend/venv/
backend/env/

# Environment secrets — never commit
.env
backend/.env
frontend/.env.local
backend/.env.example

# Streamlit cache
.streamlit/

# Jupyter
.ipynb_checkpoints/

# ---- Node / Next.js (frontend) ----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/coverage/
*.tsbuildinfo
.npm/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.kiro/

# ---- Large raw source data ----
data/bankruptcy_italian_companies_2023.xlsx
