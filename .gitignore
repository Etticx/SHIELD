# =============================================================================
# SHIELD — .gitignore
# =============================================================================

# ---- Python (root Streamlit app + backend) ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.venv/
backend/venv/
backend/env/

# Environment secrets — never commit
.env
backend/.env
frontend/.env.local
backend/.env.example

# Streamlit cache
.streamlit/

# Jupyter
.ipynb_checkpoints/

# ---- Node / Next.js (frontend) ----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/coverage/
*.tsbuildinfo
.npm/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
.idea/
*.kiro/

# ---- Large raw source data ----
data/bankruptcy_italian_companies_2023.xlsx

# Transient caches and synthetic verification outputs for the focused experiment
reports/focused_improvement/*/pipeline_cache/
reports/feature_comparison/*/pipeline_cache/
reports/.focused_verification/
frontend/.next-incomplete-*/

# Downloaded third-party datasets (re-download from source)
reports/slovak_dataset_research/original_csv/
reports/polish_dataset_research/*.zip
reports/input_transformation_audit/*.zip

# Regenerable experiment outputs
reports/approximate_mapping_experiment/all_*_predictions.csv
reports/synthetic_accounting_sanity/REPORT.html
reports/synthetic_accounting_sanity/report_browser_check.js
reports/synthetic_accounting_sanity/all_*cases.*
reports/ratio_bounds_hypothesis/**/row_checks.csv
reports/*.zip

# Superseded model (scikit-learn 1.9.0); backend uses the _sk161 refit
model/SHIELD_RF_7Features_SMOTE050_8020_CV5.joblib

# Outdated notebooks/scripts — kept locally only, not the ones in use
notebooks/archive/
