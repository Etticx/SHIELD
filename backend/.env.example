# -------------------------------------------------------
# SHIELD Backend — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# -------------------------------------------------------

# Path to the trained model file, relative to backend/
MODEL_PATH=../model/xgb_shield_model.joblib

# Allowed CORS origins (comma-separated, no spaces)
# Development:  http://localhost:3000
# Production:   https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000

# Host and port for Uvicorn
HOST=0.0.0.0
PORT=8000

# Log level: debug | info | warning | error
LOG_LEVEL=info

# -------------------------------------------------------
# Groq API — AI Advisory Engine (optional, recommended)
# -------------------------------------------------------
# Obtain a FREE API key from Groq Console (no billing required):
#   https://console.groq.com
#
# When set, /predict responses use Groq (openai/gpt-oss-120b)
# to generate dynamic, natural-language credit advisory narratives.
# Groq is fast (~500 t/s), reliable, with a free developer plan
# (1,000 requests/day, 200K tokens/day).
#
# When NOT set (or left blank), the application falls back to the
# built-in rule-based advisory engine automatically.
# The app will NEVER crash due to a missing or invalid key.
#
GROQ_API_KEY=

# -------------------------------------------------------
# PostgreSQL — Audit Persistence Layer (optional)
# -------------------------------------------------------
# Start the local database with: docker compose up -d
# Then set this URL to enable evaluation logging.
#
# When NOT set the application runs without persistence —
# predictions still work, they just aren't saved.
#
DATABASE_URL=

# -------------------------------------------------------
# API Key — Backend Route Protection
# -------------------------------------------------------
# Protects /predict and /logs from unauthenticated access.
#
# Set this to any long random string — treat it like a password.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
#
# The frontend must send this as the X-API-Key request header.
# Set the matching SHIELD_API_KEY in frontend/.env.local
#
# When NOT set, all routes remain open (development convenience).
# ALWAYS set this before any public deployment.
#
API_KEY=
