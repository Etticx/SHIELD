# -------------------------------------------------------
# SHIELD Backend — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
# -------------------------------------------------------

# Path to the trained model file, relative to backend/
MODEL_PATH=../model/xgb_shield_model.joblib

# Allowed CORS origins (comma-separated, no spaces)
# Development:  http://localhost:3000
# Production:   https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:3000

# Host and port for Uvicorn
HOST=0.0.0.0
PORT=8000

# Log level: debug | info | warning | error
LOG_LEVEL=info

# -------------------------------------------------------
# Groq API — AI Advisory Engine (optional, recommended)
# -------------------------------------------------------
# Obtain a FREE API key from Groq Console (no billing required):
#   https://console.groq.com
#
# When set, /predict responses use Groq (openai/gpt-oss-120b)
# to generate dynamic, natural-language credit advisory narratives.
# Groq is fast (~500 t/s), reliable, with a free developer plan
# (1,000 requests/day, 200K tokens/day).
#
# When NOT set (or left blank), the application falls back to the
# built-in rule-based advisory engine automatically.
# The app will NEVER crash due to a missing or invalid key.
#
GROQ_API_KEY=
